config SHEIPA
	bool

menuconfig ARCH_SHEIPA
	bool "Sheipa ARM platform"
	select SHEIPA
	select ARM_GIC
	select ARM_GIC_V3
	select HAVE_ARM_ARCH_TIMER
	select COMMON_CLK
	select GENERIC_IRQ_MULTI_HANDLER
	select CLKDEV_LOOKUP
	select GENERIC_CLOCKEVENTS
	select ARCH_HAS_CPUFREQ
	select HW_HAS_PCI
	select HW_HAS_USB
	select HAVE_ARM_SCU
	select HAVE_SMP
	select SMP
	select VFP
	select NEON
	select USE_OF
	select CPU_HAS_L2C
