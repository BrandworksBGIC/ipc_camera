#!/bin/sh

start_prog(){
	if [ -f /etc/init.d/S90peacock ]; then
		/etc/init.d/S90peacock stop
	fi

	if [ -f /bin/uvcd ] && [ -x /bin/uvcd ]; then
		uvcd &
	fi
}

stop_prog(){
	killall uvcd
}

restart_prog(){
	stop_prog
	start_prog
}

print_usage(){
	echo "usage: $PN [start | stop | restart]"
}

PN="$0"

if [ $# -eq 0 ]; then
	start_prog
elif [ $# -eq 1 ]; then
	case $1 in
		"start"):
			#echo start
			start_prog
			;;
		"stop"):
			#echo stop
			stop_prog
			;;
		"restart"):
			#echo restart
			restart_prog
			;;
		*):
			print_usage
			;;
	esac
else
	print_usage
fi
unset PN
