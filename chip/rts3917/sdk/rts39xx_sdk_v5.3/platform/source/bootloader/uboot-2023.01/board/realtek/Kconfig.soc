#
# SoC System Config
#
config SOC_PLATFORM
	string
	default "sheipa"

config SOC_SHEIPA
	bool
	default y
	select SOC_SUPPORT_ARMA7
	select SOC_SUPPORT_ARMA12
	select SOC_SUPPORT_ARMA15
	select SOC_SUPPORT_ARMA17
	select SOC_SUPPORT_ARMA32
	select SOC_SUPPORT_ARMA53
	select SOC_SUPPORT_ARMA57
	select SOC_SUPPORT_ARMA57_A53
	select SOC_SUPPORT_ARMA55
	select SOC_SUPPORT_ARMA75_A55
	select SOC_SUPPORT_SMP
	select SOC_SUPPORT_PCI
	select SOC_SUPPORT_USB
	select SOC_SUPPORT_L2C
	select SOC_CPU_ARM
	select SOC_SUPPORT_ANDROID
	select SOC_SUPPORT_FLASH
